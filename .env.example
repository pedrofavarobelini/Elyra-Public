# Local template. Do not commit .env.local or reuse demo credentials.
# npm run qa:env:local supplies ONLY values from the isolated local Supabase CLI.
# Optional integrations need independent services; see docs/Local-Setup.md.
ELYRA_RUNTIME_ENV=qa
SUPABASE_PROJECT_ID=elyra-public-snapshot-local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54381
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<configure-locally>
SUPABASE_SERVICE_ROLE_KEY=<configure-locally>
SUPABASE_DB_URL=postgresql://postgres:<local-db-password>@127.0.0.1:54382/postgres
PEDROCORE_BASE_URL=http://127.0.0.1:8000
PEDROCORE_ELYRA_API_KEY=<configure-locally>
PEDROCORE_PROVIDER_MODE=mock
PEDROCORE_ALLOW_REAL_PROVIDER=false
ELYRA_RECOVERY_DELIVERY=
ELYRA_EMAIL_TRANSPORT=local_capture
BREVO_API_KEY=<configure-locally>
ELYRA_EMAIL_SENDER_NAME=Elyra
ELYRA_EMAIL_SENDER_ADDRESS=sender@example.invalid
ELYRA_PUBLIC_APP_URL=http://localhost:3000
ELYRA_DISPATCH_SECRET=<configure-locally>
ELYRA_NOTIFICATION_TIMEZONE=
ELYRA_NOTIFICATION_SEND_HOURS=
ELYRA_EMAIL_DAILY_LIMIT=
ELYRA_NOTIFICATION_DISPATCH_BATCH=
PEDROCORE_TIMEOUT_MS=
ELYRA_TRUSTED_PROXY_HOPS=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=<configure-locally>
LIVEKIT_API_SECRET=<configure-locally>
REALTIME_ROOM_SALT=
REALTIME_E2EE_SECRET=<configure-locally>
ELYRA_CFP_OFFICIAL_ENABLED=
ELYRA_INFOSIMPLES_ENABLED=
INFOSIMPLES_TOKEN=<configure-locally>
ELYRA_DATAVALID_ENABLED=
DATAVALID_CLIENT_ID=
DATAVALID_CLIENT_SECRET=<configure-locally>
PAID_VERIFICATION_DAILY_LIMIT=
ELYRA_VERIFICATION_FIXTURES=
NEXT_PUBLIC_ELYRA_PASSKEY_RP_ID=<configure-locally>
ELYRA_DEMO_PASSWORD=<generate-a-fresh-local-value>
ELYRA_QA_CANONICAL_PASSWORD=<generate-a-fresh-local-value>
