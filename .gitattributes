* text=auto eol=lf

# Documentacao canonica
*.md text eol=lf

# Scripts
*.sh  text eol=lf
*.ps1 text eol=crlf
*.py  text eol=lf

# Binarios — nunca normalizar (referencias visuais oficiais e baseline)
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.woff  binary
*.woff2 binary

# Lockfiles
package-lock.json -diff linguist-generated=true
pnpm-lock.yaml    -diff linguist-generated=true
