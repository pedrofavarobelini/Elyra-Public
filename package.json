{
  "name": "elyra-public-snapshot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/schema-drift-check.mjs && node scripts/vendor-maplibre-worker.mjs && node scripts/build-support-content.mjs",
    "dev": "next dev",
    "db:schema:check": "node scripts/schema-drift-check.mjs",
    "prebuild": "node scripts/vendor-maplibre-worker.mjs && node scripts/build-support-content.mjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:start": "node scripts/start-local-supabase.mjs",
    "supabase:stop": "supabase stop",
    "realtime:start": "node scripts/realtime.mjs start",
    "realtime:stop": "node scripts/realtime.mjs stop",
    "qa:db:guard": "node scripts/qa-db-guard.mjs",
    "qa:db:reset": "npm run qa:db:guard && supabase db reset --local",
    "qa:db:test": "npm run qa:db:guard && supabase test db --local",
    "qa:db:lint": "npm run qa:db:guard && supabase db lint --local --schema public --level error --fail-on error",
    "qa:env:local": "node scripts/configure-local-env.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "qa:copy:data": "node scripts/qa-copy-data.mjs",
    "notifications:dispatch": "node scripts/notifications-dispatch.mjs",
    "vision:assets": "node scripts/vision-assets.mjs",
    "vision:verify": "node scripts/vision-assets.mjs --verify",
    "qa:visual-engine:real": "node scripts/qa-visual-engine-real.mjs",
    "asr:assets": "node scripts/asr-assets.mjs",
    "asr:verify": "node scripts/asr-assets.mjs --verify",
    "asr:assets:comparator": "node scripts/asr-assets.mjs --comparator",
    "asr:verify:comparator": "node scripts/asr-assets.mjs --verify --comparator",
    "qa:asr:boundary": "node scripts/qa-asr-quality-boundary.mjs",
    "qa:asr:models": "node scripts/qa-asr-model-sets.mjs",
    "qa:asr:guardrails": "node scripts/qa-asr-guardrails.mjs",
    "qa:asr:bench": "node scripts/qa-asr-benchmark.mjs",
    "qa:preflight": "node scripts/qa-preflight.ts",
    "qa:e2e": "node scripts/qa-e2e.mjs",
    "qa:probe:mutation": "node scripts/qa-mutation-response-probe.mjs",
    "qa:security": "node scripts/qa-security-probe.mjs",
    "qa": "npm run qa:public && npm run lint && npm run typecheck && npm run test && npm run build",
    "verification:emec:import": "node scripts/import-emec-snapshot.mjs",
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-demo.ps1",
    "demo:account": "node scripts/demo-account.mjs",
    "demo:professional": "node scripts/demo-professional.mjs",
    "support:network:import": "node scripts/import-support-network.mjs",
    "qa:sup1": "node scripts/qa-support-network.mjs",
    "support:content:build": "node scripts/build-support-content.mjs",
    "qa:sup3:links": "node scripts/qa-support-content-links.mjs",
    "qa:public": "node scripts/qa-public-snapshot.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@huggingface/transformers": "4.3.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "0.469.0",
    "maplibre-gl": "6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.54.2",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "25.0.1",
    "postcss": "8.5.26",
    "server-only": "0.0.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  },
  "description": "Sanitized technical portfolio snapshot of the completed Elyra project.",
  "license": "SEE LICENSE IN LICENSE"
}
